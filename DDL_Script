CREATE VIEW localized_cap_logali_Products AS SELECT
  L_0.ID,
  coalesce(localized_1.Name, L_0.Name) AS Name,
  coalesce(localized_1.Description, L_0.Description) AS Description,
  L_0.ImageUrl,
  L_0.ReleaseDate,
  L_0.DiscontinuedDate,
  L_0.Price,
  L_0.Height,
  L_0.Width,
  L_0.Depth,
  L_0.Quantity,
  L_0.Supplier_ID,
  L_0.UnitOfMeasure_Id,
  L_0.Currency_ID,
  L_0.DimensionUnit_ID,
  L_0.Category_ID,
  L_0.PriceCondition,
  L_0.PriceDetermination
FROM (cap_logali_Products AS L_0 LEFT JOIN cap_logali_Products_texts AS localized_1 ON localized_1.ID = L_0.ID AND localized_1.locale = session_context( '$user.locale' ));

